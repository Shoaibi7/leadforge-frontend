# Base URL of the LeadForge API, including /api.
# Inlined into the browser bundle at BUILD time: a production build fails if it is missing, and the
# Docker image refuses a localhost value unless ALLOW_LOCALHOST_API_URL=true (local compose only).
# Production example: https://api.<your-domain>/api  (must be same-site with the frontend, see DEPLOYMENT.md)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
